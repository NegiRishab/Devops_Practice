def gv

pipeline {
    agent any

    tools {
        nodejs 'nodejs-22'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
    }

    environment {
        AWS_REGION = credentials('aws_region')
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    stages {
        stage('Init') {
            steps {
                dir('completeProject1') {
                    script {
                        gv = load 'pipeline.groovy'
                        gv.PrepareBuild()
                    }
                }
            }
        }

        stage('Test') {
            steps {
                dir('completeProject1') {
                    script { gv.RunTests() }
                }
            }
        }

        stage('Deploy practice-project-1') {
            when { branch 'practice-project-1' }
            stages {
                stage('Create ECR and EKS infrastructure') {
                    steps {
                        dir('completeProject1') {
                            script { gv.CreateInfrastructure() }
                        }
                    }
                }

                stage('Build and push backend to ECR') {
                    steps {
                        dir('completeProject1') {
                            script { gv.BuildBackendImage() }
                        }
                    }
                }

                stage('Build and push frontend to ECR') {
                    steps {
                        dir('completeProject1') {
                            script { gv.BuildFrontendImage() }
                        }
                    }
                }

                stage('Deploy to EKS') {
                    steps {
                        dir('completeProject1') {
                            script { gv.DeployToEks() }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            // Remove workspace-specific Docker credentials, kubeconfig and plan.
            dir('completeProject1/.ci') {
                deleteDir()
            }
        }
    }
}
